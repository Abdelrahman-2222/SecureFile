# .gitattributes — tells Git how to treat files.
# Text files: Git normalises line endings, so Windows/macOS/Linux contributors do not create
# "every line changed" diffs.
* text=auto

# Windows-specific files keep Windows line endings (CRLF).
*.cs      text eol=crlf
*.xaml    text eol=crlf
*.csproj  text eol=crlf
*.slnx    text eol=crlf
*.props   text eol=crlf
*.ps1     text eol=crlf

# Shell scripts must keep Unix line endings (LF) or they fail on Linux/macOS.
*.sh      text eol=lf

# Binary files: never touched. IMPORTANT for encrypted test fixtures ("golden files", T-28):
# a single changed byte would break their HMAC and the tests.
*.enc     binary
*.bin     binary
*.png     binary
*.jpg     binary
*.ico     binary
*.pdf     binary
*.docx    binary
*.pptx    binary
