<Window x:Class="SecureFile.Avalonia.AboutWindow"
        x:ClassModifier="internal"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SecureFile"
        Icon="/Assets/SecureFile.ico"
        Width="420" SizeToContent="Height" CanResize="False"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock Text="SecureFile" FontSize="24" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" AutomationProperties.AutomationId="AboutVersion" FontSize="14" Margin="0,4,0,0" />
        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,16,0,0"
                   Text="Encrypts and decrypts files on this computer with AES-256 and a password. Nothing is sent over the network. If you forget the password, the file cannot be recovered." />
        <Button x:Name="CloseButton" Content="Close" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
                MinWidth="96" MinHeight="40" Margin="0,24,0,0" />
    </StackPanel>
</Window>
