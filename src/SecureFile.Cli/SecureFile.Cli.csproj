<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The command-line version (plan Step 7.6): the same engine as the Windows app, for macOS, Linux, Windows and scripts.
    It is a thin shell: Cli -> Presentation (friendly error messages) -> Core. The executable is called "securefile".
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>securefile</AssemblyName>
    <RootNamespace>SecureFile.Cli</RootNamespace>
    <!-- Trimming and Native AOT analyzers on, so the published executable can be small (see scripts/publish-cli.ps1). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecureFile.Presentation\SecureFile.Presentation.csproj" />
    <ProjectReference Include="..\SecureFile.Core\SecureFile.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SecureFile.Cli.Tests" />
  </ItemGroup>

</Project>
