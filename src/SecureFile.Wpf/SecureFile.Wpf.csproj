<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows desktop app (required track). net10.0-windows = .NET 10 plus Windows-only APIs such as WPF. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SecureFile.Wpf</RootNamespace>
    <AssemblyName>SecureFile</AssemblyName>
    <!-- Per-monitor DPI awareness and long-path support are declared in app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: the Fluent theme (Application.ThemeMode) is experimental in .NET 10 but is the supported way to get it. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The icon of SecureFile.exe in Explorer and the taskbar. The same file is also embedded for the window (below). -->
    <ApplicationIcon>Assets\SecureFile.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\SecureFile.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecureFile.Presentation\SecureFile.Presentation.csproj" />
    <ProjectReference Include="..\SecureFile.Core\SecureFile.Core.csproj" />
  </ItemGroup>

</Project>
