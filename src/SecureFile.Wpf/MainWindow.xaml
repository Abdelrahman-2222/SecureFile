<Window x:Class="SecureFile.Wpf.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureFile"
        Icon="Assets/SecureFile.ico"
        Width="800" SizeToContent="Height"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowKeyDown">
    <Window.InputBindings>
        <!-- Ctrl+O = Browse (PROJECT_PLAN §11.2). Enter in the password box runs the primary action (below). -->
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 4/8 px grid; 14 px body text; 40 px high main actions (PROJECT_PLAN §11.2). Colours and the Fluent theme come in 3.3. -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,6" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <!-- Top to bottom, as in PROJECT_PLAN §11.1. Mode switch, confirm password, output "Change…", MB/s, Cancel and
         Open folder arrive in Steps 3.4/3.5 together with the ViewModel support they need. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- 1. Drop zone: says "drop" so drag-and-drop can be found (plan §11.1); highlighted while a file is dragged over it. -->
            <Border x:Name="DropZone" AutomationProperties.AutomationId="DropZone"
                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="2" CornerRadius="8" Padding="24" Background="Transparent"
                    AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnFileDropped">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Drop a file here or" FontSize="18" HorizontalAlignment="Center" />
                    <Button x:Name="BrowseButton" AutomationProperties.AutomationId="BrowseButton"
                            AutomationProperties.Name="Browse for a file"
                            Content="_Browse…" ToolTip="Browse (Ctrl+O)" Command="{Binding BrowseCommand}"
                            HorizontalAlignment="Center" Margin="0,12,0,0" MinWidth="140" />
                </StackPanel>
            </Border>

            <!-- 2. File card; the tooltip has the full name, folder, date and exact size (review items 16 and 33). -->
            <Border ToolTip="{Binding FileCardToolTip}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                <TextBlock x:Name="FileSummaryText" AutomationProperties.AutomationId="FileSummary"
                           Text="{Binding FileSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- 4. Password -->
            <Label x:Name="PasswordLabel" Content="_Password" Target="{Binding ElementName=PasswordInput}" Margin="0,16,0,4" Padding="0" FontSize="14" />
            <!-- The PasswordBox and the plain TextBox share one cell; "Show password" swaps which one is visible. -->
            <Grid>
                <PasswordBox x:Name="PasswordInput" AutomationProperties.AutomationId="PasswordInput"
                             AutomationProperties.Name="Password"
                             MinHeight="32" FontSize="14" VerticalContentAlignment="Center"
                             IsEnabled="{Binding CanEditInputs}"
                             MaxLength="1024" PasswordChanged="OnPasswordChanged">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding RunPrimaryCommand}" />
                    </PasswordBox.InputBindings>
                </PasswordBox>
                <TextBox x:Name="PasswordVisibleInput" AutomationProperties.AutomationId="PasswordVisibleInput"
                         AutomationProperties.Name="Password (visible)"
                         Visibility="Collapsed" UndoLimit="0"
                         MinHeight="32" FontSize="14" VerticalContentAlignment="Center"
                         IsEnabled="{Binding CanEditInputs}"
                         MaxLength="1024" TextChanged="OnVisiblePasswordChanged">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding RunPrimaryCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </Grid>

            <!-- Only when a password is being chosen (encrypting): strength advice and the confirmation box. Decrypting
                 asks for the old password once and applies no rules to it. -->
            <StackPanel Visibility="{Binding IsEncrypting, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar AutomationProperties.AutomationId="PasswordStrengthBar" AutomationProperties.Name="Password strength"
                             Value="{Binding StrengthPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" Margin="0,8,0,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Strength}" Value="TooShort">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Strength}" Value="Weak">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Strength}" Value="Fair">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Strength}" Value="Strong">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <!-- The text takes the colour of the bar; the words carry the meaning too, colour is only an extra cue. -->
                <TextBlock x:Name="StrengthLabel" AutomationProperties.AutomationId="PasswordStrengthText"
                           Text="{Binding StrengthText}" TextWrapping="Wrap" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Strength}" Value="TooShort">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Strength}" Value="Weak">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Strength}" Value="Fair">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Strength}" Value="Strong">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StrengthText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Label x:Name="ConfirmLabel" Content="Co_nfirm password" Target="{Binding ElementName=ConfirmInput}" Margin="0,12,0,4" Padding="0" FontSize="14" />
                <Grid>
                    <PasswordBox x:Name="ConfirmInput" AutomationProperties.AutomationId="ConfirmInput"
                                 AutomationProperties.Name="Confirm password"
                                 MinHeight="32" FontSize="14" VerticalContentAlignment="Center"
                                 IsEnabled="{Binding CanEditInputs}"
                                 MaxLength="1024" PasswordChanged="OnPasswordChanged">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RunPrimaryCommand}" />
                        </PasswordBox.InputBindings>
                    </PasswordBox>
                    <TextBox x:Name="ConfirmVisibleInput" AutomationProperties.AutomationId="ConfirmVisibleInput"
                             AutomationProperties.Name="Confirm password (visible)"
                             Visibility="Collapsed" UndoLimit="0"
                             MinHeight="32" FontSize="14" VerticalContentAlignment="Center"
                             IsEnabled="{Binding CanEditInputs}"
                             MaxLength="1024" TextChanged="OnVisiblePasswordChanged">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RunPrimaryCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
                <!-- Collapsed while empty, so an unused line does not leave a gap. -->
                <TextBlock AutomationProperties.AutomationId="PasswordMatchText" Text="{Binding PasswordMatchText}"
                           TextWrapping="Wrap" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PasswordsMatch}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPasswordMismatch}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PasswordMatchText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <CheckBox x:Name="ShowPasswordCheck" AutomationProperties.AutomationId="ShowPasswordCheck"
                      Content="_Show password" Margin="0,8,0,0"
                      Checked="OnShowPasswordChanged" Unchecked="OnShowPasswordChanged" />
            <TextBlock x:Name="CapsLockWarning" AutomationProperties.AutomationId="CapsLockWarning"
                       Text="Caps Lock is on." FontWeight="SemiBold" Visibility="Collapsed" Margin="0,8,0,0"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <!-- When a password is being chosen the note is a caution (amber, bold, with a symbol), not an error (red):
                 red means "something failed". When decrypting it is a plain reminder. -->
            <Border CornerRadius="8" Padding="12,8" Margin="0,8,0,0" BorderThickness="1" BorderBrush="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <!-- Nothing to say until a file is chosen. -->
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDecrypting}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEncrypting}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x26A0;" FontFamily="Segoe UI Symbol" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEncrypting}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="PasswordHintText" AutomationProperties.AutomationId="PasswordHint"
                               Text="{Binding PasswordHint}" TextWrapping="Wrap" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEncrypting}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 6. Primary actions -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="EncryptButton" AutomationProperties.AutomationId="EncryptButton"
                        AutomationProperties.Name="Encrypt file"
                        Content="Encrypt file" Command="{Binding EncryptCommand}" IsEnabled="{Binding IsEncryptOffered}"
                        ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0" MinWidth="140">
                    <!-- The tooltip exists only while the button is off because the file is already encrypted. -->
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEncryptOffered}" Value="False">
                                    <Setter Property="ToolTip" Value="This file is already encrypted. Use Decrypt." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="DecryptButton" AutomationProperties.AutomationId="DecryptButton"
                        AutomationProperties.Name="Decrypt file"
                        Content="Decrypt file" Command="{Binding DecryptCommand}" IsEnabled="{Binding IsDecryptOffered}"
                        ToolTipService.ShowOnDisabled="True" MinWidth="140">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDecryptOffered}" Value="False">
                                    <Setter Property="ToolTip" Value="This file is not encrypted by SecureFile. Use Encrypt." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- 7. Progress: shown only while an operation or a file read is running -->
            <Grid Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <ProgressBar x:Name="OperationProgress" AutomationProperties.AutomationId="OperationProgress"
                                 AutomationProperties.Name="Progress"
                                 Value="{Binding ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100" Height="12"
                                 IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
                    <TextBlock x:Name="ProgressDetailText" AutomationProperties.AutomationId="ProgressText"
                               Text="{Binding ProgressText}" Margin="0,8,0,0" />
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="1" AutomationProperties.AutomationId="CancelButton"
                        AutomationProperties.Name="Cancel"
                        Content="Cancel" ToolTip="Cancel (Esc)" Command="{Binding CancelCommand}" Margin="16,0,0,0" />
            </Grid>

            <!-- 8. Result / status -->
            <!-- A coloured banner after the operation ends (green = done, red = failed), so the result cannot be missed;
                 neutral while idle or working. The text carries the meaning too, colour is only an extra cue. -->
            <Border CornerRadius="8" Padding="16,12" Margin="0,16,0,0" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSucceeded}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusMessage"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold" />
            </Border>
            <Button x:Name="OpenFolderButton" AutomationProperties.AutomationId="OpenFolderButton"
                    AutomationProperties.Name="Open folder"
                    Content="Open _folder" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                    Visibility="{Binding IsSucceeded, Converter={StaticResource BoolToVisibility}}" />

            <Button x:Name="AboutButton" AutomationProperties.AutomationId="AboutButton"
                    AutomationProperties.Name="About SecureFile"
                    Content="_About" ToolTip="About (F1)" Click="OnAboutClick" HorizontalAlignment="Right" Margin="0,24,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
