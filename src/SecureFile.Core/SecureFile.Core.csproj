<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core: encryption, file format and file details. No UI references, so it runs on every OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SecureFile.Core</RootNamespace>
    <!-- Turns on the trimming and Native AOT analyzers now, so Core stays ready for the small, fast
         cross-platform build (ADR-01 bonus) instead of discovering problems late. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the unit tests reach "internal" helpers without making them public. -->
    <InternalsVisibleTo Include="SecureFile.Core.Tests" />
    <!-- The benchmarks time the internal key derivation directly (Step 5.1). -->
    <InternalsVisibleTo Include="SecureFile.Benchmarks" />
  </ItemGroup>

</Project>
