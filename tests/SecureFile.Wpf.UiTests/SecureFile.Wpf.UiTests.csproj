<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI tests that start the real SecureFile.exe and drive it through Windows UI Automation (FlaUI).
    They need an unlocked desktop session and real file dialogs, so they run only when the environment variable
    SECUREFILE_UI_TESTS=1 is set (otherwise they are reported as skipped and the gate stays fast and stable).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Builds the app first (so the .exe exists) without referencing its code. -->
    <ProjectReference Include="..\..\src\SecureFile.Wpf\SecureFile.Wpf.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
