<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration tests: real files in temporary folders (permissions, overwrite, cancel, golden files). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Exit code 8 = "zero tests ran". Ignored only while this project has no tests yet.
      Remove this line when its first test is added (see PROJECT_PLAN stage for this project).
    -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SecureFile.Core\SecureFile.Core.csproj" />
  </ItemGroup>

</Project>
